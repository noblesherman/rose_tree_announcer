[Unit]
Description=Rose Tree local display kiosk
After=rose-tree-announcer.service
Requires=rose-tree-announcer.service

[Service]
Type=simple
User=rosetreepark
Group=rosetreepark
Environment=HOME=/home/rosetreepark
ExecStartPre=/usr/bin/curl --fail --silent --show-error http://127.0.0.1:5001/api/status
ExecStart=__PROJECT_DIR__/scripts/rose-tree-kiosk
Restart=on-failure
RestartSec=2
StartLimitIntervalSec=60
StartLimitBurst=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
